<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both stubs are generated in one project: the client stubs dial peers directly, and the
         server base classes (Services/*.cs) back this bus's own embedded ASP.NET Core/Kestrel host
         — fully self-contained like every other transport in this repo, rather than requiring the
         consuming application to already be an ASP.NET Core app with its own pipeline to map onto. -->
    <Protobuf Include="Protos\cluster.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebApplication/WebApplicationBuilder/MapGrpcService and Kestrel configuration live in the
         ASP.NET Core shared framework; this is a plain class library (not Microsoft.NET.Sdk.Web),
         so it must be referenced explicitly rather than relying on the Web SDK to add it implicitly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThunderPropagator.ClusterMessageBuses.SharedKernel\ThunderPropagator.ClusterMessageBuses.SharedKernel.csproj" />
  </ItemGroup>

</Project>
