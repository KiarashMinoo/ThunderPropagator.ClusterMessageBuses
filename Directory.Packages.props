<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <PropertyGroup Label="ThunderPropagatorPackages">
    <BuildingBlocksVersion>1.0.1-beta.114</BuildingBlocksVersion>
    <BuildingBlocksPackageId>ThunderPropagator.BuildingBlocks$(PackageIdConfigurationSuffix)$(PackageIdPlatformSuffix)</BuildingBlocksPackageId>
    <!-- IClusterMessageBus / AbstractClusterMessageBus (core issue #340, #346) only ship in the
         "Cluster"-flavored core packages (core's own Cluster build configuration, published
         alongside its regular Debug/Release ones — see core Directory.Build.props /
         .github/workflows/ci.yml). That ".Cluster" suffix is a fixed, separate package id, not
         core's PackageIdConfigurationSuffix/PackageIdPlatformSuffix (those describe THIS repo's own
         Debug/Release/AnyCPU/x64 packaging, unrelated to which flavor of the upstream core packages
         we depend on) — so it's hardcoded here rather than reusing those MSBuild properties. -->
    <ThunderPropagatorVersion>1.0.1-beta.195</ThunderPropagatorVersion>
    <ThunderPropagatorPackageId>ThunderPropagator.Cluster</ThunderPropagatorPackageId>
    <ThunderPropagatorApplicationPackageId>ThunderPropagator.Application.Cluster</ThunderPropagatorApplicationPackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="$(BuildingBlocksPackageId)" Version="$(BuildingBlocksVersion)" />
    <PackageVersion Include="$(ThunderPropagatorPackageId)" Version="$(ThunderPropagatorVersion)" />
    <PackageVersion Include="$(ThunderPropagatorApplicationPackageId)" Version="$(ThunderPropagatorVersion)" />
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <!-- Transport-agnostic retry/circuit-breaker building block for SharedKernel's
         ClusterResiliencePipelineFactory. Deliberately not Microsoft.Extensions.Http.Resilience /
         Microsoft.Extensions.Http.Polly — those are HttpClient-specific and don't apply to the
         gRPC streams, ZeroMQ sockets, or broker connections the future transport projects here
         will wrap. -->
    <PackageVersion Include="Polly.Core" Version="8.6.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>
  <ItemGroup Label="Kafka">
    <PackageVersion Include="Confluent.Kafka" Version="2.14.2" />
  </ItemGroup>
  <ItemGroup Label="RabbitMQ">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>
  <ItemGroup Label="NATS">
    <PackageVersion Include="NATS.Net" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Label="Pulsar">
    <PackageVersion Include="DotPulsar" Version="5.3.1" />
  </ItemGroup>
  <ItemGroup Label="Mqtt">
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>
  <ItemGroup Label="ActiveMQ">
    <PackageVersion Include="Apache.NMS" Version="2.2.0" />
    <PackageVersion Include="Apache.NMS.ActiveMQ" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Label="RedisPubSub">
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>
  <ItemGroup Label="AwsSqs">
    <!-- Same versions already pinned by ThunderPropagator.Feeviders' AwsSqs projects, for
         consistency across the org. AWS SDK v4 packages target net8.0+ only, which matches this
         repo's net8.0/net9.0/net10.0 multi-targeting exactly. -->
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.5" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.5" />
  </ItemGroup>
  <ItemGroup Label="Testing Packages">
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
