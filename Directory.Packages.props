<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <!-- This repo depends on the CLUSTER variant of the core package, not the plain one:
       ThunderPropagatorClusterPackageId (from Shared.PackageIds.props, imported via
       Directory.Build.props -> SharedProps.props -> Shared.NugetBuild.props) is the correct,
       already-existing property for that. A local ThunderPropagatorPackageId property used to
       live here instead, shadowing the shared file's OWN ThunderPropagatorPackageId (which
       means the plain, non-Cluster package) with a different value; harmless only by
       accident, since nothing else in the repo family expected this file's local override to
       apply anywhere else. Only the version pin stays local. -->
  <ItemGroup>
    <PackageVersion Include="$(ThunderPropagatorClusterPackageId)" Version="1.0.1-beta.205" />
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <!-- Transport-agnostic retry/circuit-breaker building block for SharedKernel's
         ClusterResiliencePipelineFactory. Deliberately not Microsoft.Extensions.Http.Resilience /
         Microsoft.Extensions.Http.Polly — those are HttpClient-specific and don't apply to the
         gRPC streams, ZeroMQ sockets, or broker connections the future transport projects here
         will wrap. -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'" Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>
  <ItemGroup Label="Kafka">
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
  </ItemGroup>
  <ItemGroup Label="RabbitMQ">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>
  <ItemGroup Label="NATS">
    <PackageVersion Include="NATS.Net" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup Label="Pulsar">
    <PackageVersion Include="DotPulsar" Version="5.3.3" />
  </ItemGroup>
  <ItemGroup Label="Mqtt">
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>
  <ItemGroup Label="ActiveMQ">
    <PackageVersion Include="Apache.NMS" Version="2.2.0" />
    <PackageVersion Include="Apache.NMS.ActiveMQ" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Label="RedisPubSub">
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>
  <ItemGroup Label="AwsSqs">
    <!-- Same versions already pinned by ThunderPropagator.Feeviders' AwsSqs projects, for
         consistency across the org. AWS SDK v4 packages target net8.0+ only, which matches this
         repo's net8.0/net9.0/net10.0 multi-targeting exactly. -->
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.11" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.100.12" />
  </ItemGroup>
  <ItemGroup Label="AzureServiceBus">
    <!-- Same version already pinned by ThunderPropagator.Feeviders' AzureServiceBus projects. -->
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
  </ItemGroup>
  <ItemGroup Label="GcpPubSub">
    <!-- PublisherServiceApiClient/SubscriberServiceApiClient are GAPIC-generated with a protected
         parameterless constructor and virtual members specifically for direct test substitution
         (Google's documented pattern) - no custom wrapper interface needed, same reasoning as
         AWSSDK.SQS/AWSSDK.SimpleNotificationService above. -->
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.37.0" />
  </ItemGroup>
  <ItemGroup Label="Grpc">
    <!-- Grpc.AspNetCore brings in Grpc.AspNetCore.Server (for MapGrpcService on the host's own
         ASP.NET Core pipeline) and Google.Protobuf transitively; Grpc.Net.Client is the HTTP/2
         channel/client-stub stack used to dial peers. Grpc.Tools is a build-time-only codegen
         package (PrivateAssets="all" on the PackageReference) that turns cluster.proto into the
         generated client/server base classes — ClientBase&lt;T&gt;-derived clients have a protected
         parameterless constructor and virtual RPC methods specifically to support direct test
         substitution, the same reasoning as GcpPubSub's GAPIC clients above. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
  </ItemGroup>
  <ItemGroup Label="ZeroMQ">
    <!-- NetMQ is the pure-managed ZeroMQ binding for .NET (no native libzmq interop), consistent
         with the ZeroMQ Feeder/Provider design in ThunderPropagator.Feeviders. RouterSocket/
         DealerSocket (the classic, stable ZMQ pattern this transport uses per the ticket) are not
         thread-safe and require single-thread affinity — NetMQPoller + NetMQQueue is the standard
         NetMQ pattern for coordinating access to them from arbitrary caller threads. -->
    <PackageVersion Include="NetMQ" Version="4.0.4.3" />
    <!-- NetMQ 4.0.4.2 itself hard-pins System.Security.Cryptography.Xml 10.0.6, which has several
         known high-severity DoS advisories (GHSA-23rf-6693-g89p and siblings, July 2026 .NET Patch
         Tuesday). Pinned up to the patched 10.0.10 release directly so it wins resolution over
         NetMQ's transitive minimum. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Testing Packages">
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
